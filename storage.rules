rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Hilfsfunktionen
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Benutzer-spezifische Dateien
    match /users/{userId}/{allPaths=**} {
      // Lesen: Nur der Besitzer oder jemand mit Enrollment
      allow read: if isSignedIn();
      
      // Schreiben: Nur der Besitzer und Datei maximal 1000 MB
      allow write: if isOwner(userId) && request.resource.size <= 1000 * 1024 * 1024;
      
      // Löschen: Nur der Besitzer
      allow delete: if isOwner(userId);
    }
    
    // Profilbilder
    match /profilePictures/{userId} {
      // Lesen: Nur eingeloggte Nutzer
      allow read: if isSignedIn();
      
      // Schreiben: Nur der Besitzer und Datei maximal 5 MB
      allow write: if isOwner(userId) && request.resource.size <= 5 * 1024 * 1024;
      
      // Löschen: Nur der Besitzer
      allow delete: if isOwner(userId);
    }
    
    // Firmenlogos
    match /logos/{userId} {
      // Lesen: Nur eingeloggte Nutzer
      allow read: if isSignedIn();
      
      // Schreiben: Nur der Besitzer und Datei maximal 2 MB
      allow write: if isOwner(userId) && request.resource.size <= 2 * 1024 * 1024;
      
      // Löschen: Nur der Besitzer
      allow delete: if isOwner(userId);
    }
    
    // Kurs-Cover-Bilder
    match /courseCovers/{userId}/{courseId} {
      // Lesen: Jeder eingeloggte Nutzer
      allow read: if isSignedIn();
      
      // Schreiben: Nur der Besitzer und Datei maximal 10 MB
      allow write: if isOwner(userId) && request.resource.size <= 10 * 1024 * 1024;
      
      // Löschen: Nur der Besitzer
      allow delete: if isOwner(userId);
    }
  }
}
